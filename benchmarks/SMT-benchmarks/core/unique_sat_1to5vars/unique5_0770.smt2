; unique_target=10000
(set-logic QF_BV)
(declare-fun x1 () Bool)
(declare-fun x2 () Bool)
(declare-fun x3 () Bool)
(declare-fun x4 () Bool)
(declare-fun x5 () Bool)
(assert x1)
(assert (or x4 (not x5) (not x1)))
(assert (not x2))
(assert (not x3))
(assert (or x2 (not x4)))
(assert (or (not x5) x2 x1))
(assert (or (not x3) x1))
(assert (or (not x5) x3 x4))
(assert (or x4 x3 x1))
(check-sat)
(get-model)