; unique_target=1100
(set-logic QF_BV)
(declare-fun x1 () Bool)
(declare-fun x2 () Bool)
(declare-fun x3 () Bool)
(declare-fun x4 () Bool)
(assert (or (not x3) (not x2) (not x1)))
(assert (or (not x2) (not x4) x3))
(assert (or (not x3) x4 (not x2)))
(assert (not x4))
(assert x2)
(assert (or x1 x4))
(assert x1)
(assert (not x3))
(assert (or (not x3) (not x2) (not x4)))
(assert (or x4 x1 x2))
(check-sat)
(get-model)