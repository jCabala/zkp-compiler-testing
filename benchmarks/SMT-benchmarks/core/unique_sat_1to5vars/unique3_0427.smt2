; unique_target=100
(set-logic QF_BV)
(declare-fun x1 () Bool)
(declare-fun x2 () Bool)
(declare-fun x3 () Bool)
(assert (or (not x2) (not x3)))
(assert x1)
(assert (or (not x2) x3))
(assert (not x3))
(assert (or x1 (not x2) (not x3)))
(assert (or (not x2) x1 (not x3)))
(assert (or x3 x2 x1))
(assert (or x2 x3 x1))
(check-sat)
(get-model)