; unique_target=0001
(set-logic QF_BV)
(declare-fun x1 () Bool)
(declare-fun x2 () Bool)
(declare-fun x3 () Bool)
(declare-fun x4 () Bool)
(assert (not x1))
(assert (or x2 (not x3)))
(assert (or x1 (not x3)))
(assert (or (not x2) x1))
(assert (or x1 x4))
(assert (or (not x3) (not x2)))
(assert (or (not x2) (not x3)))
(assert (or x1 (not x2) x4))
(check-sat)
(get-model)