(set-logic QF_BV)
(declare-fun x1 () Bool)
(declare-fun x2 () Bool)
(declare-fun x3 () Bool)
(declare-fun x4 () Bool)
(assert (or (not x1) (not x3)))
(assert (or x3 (not x2) (not x4)))
