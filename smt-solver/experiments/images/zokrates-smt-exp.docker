FROM docker.io/veridise/picus:base

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /
USER root

RUN apt-get update && \
    apt-get -y install \
        git \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
        build-essential \
        cmake \
        libgmp-dev \
        libboost-all-dev \
        libssl-dev \
        coinor-cbc \
        coinor-libcbc-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Rust to a fresh path so we get a modern Cargo (base image has an old
# version that cannot parse Cargo.lock v4). Installing to /opt/rust avoids the
# cross-device rename error that occurs when updating the base image's rustup.
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path
ENV PATH="/opt/rust/cargo/bin:${PATH}"

# Install ZoKrates compiler.
RUN curl -LSfs get.zokrat.es | sh
ENV PATH="/root/.zokrates/bin:${PATH}"

RUN python3 -m pip install --no-cache-dir \
        click \
        pysmt \
        z3-solver \
        antlr4-python3-runtime==4.7.2

# Ensure Picus runtime path expected by smt-solver exists.
RUN if [ ! -x /Picus/run-picus ]; then \
      git clone --depth 1 https://github.com/Veridise/Picus.git /Picus && \
      cd /Picus && raco make picus.rkt ; \
    fi && \
    ln -sf /Picus/run-picus /usr/local/bin/run-picus && \
    ln -sfn /Picus /root/Picus

WORKDIR /workspace/smt-solver
CMD ["bash"]
