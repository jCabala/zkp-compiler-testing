FROM docker.io/veridise/picus:base

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /
USER root

RUN apt-get update && \
    apt-get -y install \
        git \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        click \
        pysmt \
        z3-solver \
        antlr4-python3-runtime==4.7.2

# Install a current Rust toolchain for the ACIR decoder build.
RUN rm -rf /root/.cargo /root/.rustup && \
    curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain stable

# Install the Noir toolchain using the official noirup installer.
RUN curl -L https://raw.githubusercontent.com/noir-lang/noirup/refs/heads/main/install | bash
ENV PATH="/root/.cargo/bin:/root/.nargo/bin:/root/.local/bin:${PATH}"
RUN noirup

# Ensure Picus runtime path expected by smt-solver exists.
RUN if [ ! -x /Picus/run-picus ]; then \
      git clone --depth 1 https://github.com/Veridise/Picus.git /Picus && \
      cd /Picus && raco make picus.rkt ; \
    fi && \
    ln -sf /Picus/run-picus /usr/local/bin/run-picus && \
    ln -sfn /Picus /root/Picus

WORKDIR /workspace/smt-solver
CMD ["bash"]
