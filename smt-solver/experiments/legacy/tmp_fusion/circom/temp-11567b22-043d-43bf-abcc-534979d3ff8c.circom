pragma circom 2.0.6;

include "../circomlib/comparators.circom";

include "../circomlib/gates.circom";

template main_template() {
    signal input scr1_x1;
    signal input scr1_x2;
    signal input scr1_x3;
    signal input scr1_x4;
    signal input scr1_x5;
    signal input scr2_x1;
    signal input scr2_x2;
    signal input scr2_x3;
    signal output scr1_x5_scr2_x2_fused;
    signal output scr1_x1_scr2_x3_fused;
    signal output scr1_x3_scr2_x1_fused;
    scr1_x5_scr2_x2_fused <-- ((scr1_x5 + scr2_x2) - (2 * (scr1_x5 * scr2_x2)));
    scr1_x1_scr2_x3_fused <-- ((scr1_x1 + scr2_x3) - (2 * (scr1_x1 * scr2_x3)));
    scr1_x3_scr2_x1_fused <-- ((scr1_x3 + scr2_x1) - (2 * (scr1_x3 * scr2_x1)));
    (scr1_x1 * (1 - scr1_x1)) === 0;
    (scr1_x2 * (1 - scr1_x2)) === 0;
    (scr1_x3 * (1 - scr1_x3)) === 0;
    (scr1_x4 * (1 - scr1_x4)) === 0;
    (scr1_x5 * (1 - scr1_x5)) === 0;
    (scr2_x1 * (1 - scr2_x1)) === 0;
    (scr2_x2 * (1 - scr2_x2)) === 0;
    (scr2_x3 * (1 - scr2_x3)) === 0;
    (scr1_x5_scr2_x2_fused * (1 - scr1_x5_scr2_x2_fused)) === 0;
    (scr1_x1_scr2_x3_fused * (1 - scr1_x1_scr2_x3_fused)) === 0;
    (scr1_x3_scr2_x1_fused * (1 - scr1_x3_scr2_x1_fused)) === 0;
    component comp_0 = IsEqual();
    comp_0.in[0] <== scr1_x1_scr2_x3_fused;
    comp_0.in[1] <== scr2_x3;
    component comp_1 = AND();
    comp_1.a <== scr1_x2;
    comp_1.b <== comp_0.out;
    component comp_2 = IsEqual();
    comp_2.in[0] <== scr1_x5_scr2_x2_fused;
    comp_2.in[1] <== scr2_x2;
    component comp_3 = AND();
    comp_3.a <== comp_1.out;
    comp_3.b <== comp_2.out;
    component comp_4 = IsEqual();
    comp_4.in[0] <== scr1_x1_scr2_x3_fused;
    comp_4.in[1] <== scr2_x3;
    component comp_5 = NOT();
    comp_5.in <== comp_4.out;
    component comp_6 = OR();
    comp_6.a <== comp_5.out;
    comp_6.b <== scr1_x4;
    component comp_7 = AND();
    comp_7.a <== comp_3.out;
    comp_7.b <== comp_6.out;
    component comp_8 = IsEqual();
    comp_8.in[0] <== scr1_x5_scr2_x2_fused;
    comp_8.in[1] <== scr2_x2;
    component comp_9 = NOT();
    comp_9.in <== comp_8.out;
    component comp_10 = IsEqual();
    comp_10.in[0] <== scr1_x3_scr2_x1_fused;
    comp_10.in[1] <== scr2_x1;
    component comp_11 = OR();
    comp_11.a <== comp_9.out;
    comp_11.b <== comp_10.out;
    component comp_12 = AND();
    comp_12.a <== comp_7.out;
    comp_12.b <== comp_11.out;
    component comp_13 = NOT();
    comp_13.in <== scr1_x4;
    component comp_14 = IsEqual();
    comp_14.in[0] <== scr1_x5_scr2_x2_fused;
    comp_14.in[1] <== scr2_x2;
    component comp_15 = OR();
    comp_15.a <== comp_13.out;
    comp_15.b <== comp_14.out;
    component comp_16 = AND();
    comp_16.a <== comp_12.out;
    comp_16.b <== comp_15.out;
    component comp_17 = NOT();
    comp_17.in <== scr2_x1;
    component comp_18 = OR();
    comp_18.a <== scr2_x3;
    comp_18.b <== comp_17.out;
    component comp_19 = NOT();
    comp_19.in <== scr2_x2;
    component comp_20 = OR();
    comp_20.a <== comp_18.out;
    comp_20.b <== comp_19.out;
    component comp_21 = NOT();
    comp_21.in <== scr2_x1;
    component comp_22 = NOT();
    comp_22.in <== scr2_x3;
    component comp_23 = OR();
    comp_23.a <== comp_21.out;
    comp_23.b <== comp_22.out;
    component comp_24 = AND();
    comp_24.a <== comp_20.out;
    comp_24.b <== comp_23.out;
    component comp_25 = AND();
    comp_25.a <== comp_24.out;
    comp_25.b <== scr2_x3;
    component comp_26 = NOT();
    comp_26.in <== scr2_x2;
    component comp_27 = NOT();
    comp_27.in <== scr2_x3;
    component comp_28 = OR();
    comp_28.a <== comp_26.out;
    comp_28.b <== comp_27.out;
    component comp_29 = OR();
    comp_29.a <== comp_28.out;
    comp_29.b <== scr2_x1;
    component comp_30 = AND();
    comp_30.a <== comp_25.out;
    comp_30.b <== comp_29.out;
    component comp_31 = NOT();
    comp_31.in <== scr2_x1;
    component comp_32 = OR();
    comp_32.a <== comp_31.out;
    comp_32.b <== scr2_x2;
    component comp_33 = OR();
    comp_33.a <== comp_32.out;
    comp_33.b <== scr2_x3;
    component comp_34 = AND();
    comp_34.a <== comp_30.out;
    comp_34.b <== comp_33.out;
    component comp_35 = NOT();
    comp_35.in <== scr2_x2;
    component comp_36 = OR();
    comp_36.a <== scr2_x3;
    comp_36.b <== comp_35.out;
    component comp_37 = NOT();
    comp_37.in <== scr2_x1;
    component comp_38 = OR();
    comp_38.a <== comp_36.out;
    comp_38.b <== comp_37.out;
    component comp_39 = AND();
    comp_39.a <== comp_34.out;
    comp_39.b <== comp_38.out;
    component comp_40 = NOT();
    comp_40.in <== scr2_x3;
    component comp_41 = OR();
    comp_41.a <== scr2_x2;
    comp_41.b <== comp_40.out;
    component comp_42 = NOT();
    comp_42.in <== scr2_x1;
    component comp_43 = OR();
    comp_43.a <== comp_41.out;
    comp_43.b <== comp_42.out;
    component comp_44 = AND();
    comp_44.a <== comp_39.out;
    comp_44.b <== comp_43.out;
    component comp_45 = NOT();
    comp_45.in <== scr2_x2;
    component comp_46 = AND();
    comp_46.a <== comp_44.out;
    comp_46.b <== comp_45.out;
    component comp_47 = AND();
    comp_47.a <== comp_16.out;
    comp_47.b <== comp_46.out;
    component comp_48 = IsZero();
    comp_48.in <== comp_47.out;
    component comp_49 = NOT();
    comp_49.in <== comp_48.out;
    comp_49.out === 1;
    log("<@> scr1_x5_scr2_x2_fused = ", scr1_x5_scr2_x2_fused);
    log("<@> scr1_x1_scr2_x3_fused = ", scr1_x1_scr2_x3_fused);
    log("<@> scr1_x3_scr2_x1_fused = ", scr1_x3_scr2_x1_fused);
}

component main = main_template();
