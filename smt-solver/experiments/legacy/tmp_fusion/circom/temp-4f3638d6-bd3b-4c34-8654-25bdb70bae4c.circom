pragma circom 2.0.6;

include "../circomlib/gates.circom";

include "../circomlib/comparators.circom";

template main_template() {
    signal input scr1_x1;
    signal input scr2_x1;
    signal input scr2_x2;
    signal input scr2_x3;
    signal input scr2_x4;
    signal input scr2_x5;
    signal output scr1_x1_scr2_x1_fused;
    scr1_x1_scr2_x1_fused <-- ((scr1_x1 + scr2_x1) - (2 * (scr1_x1 * scr2_x1)));
    (scr1_x1 * (1 - scr1_x1)) === 0;
    (scr2_x1 * (1 - scr2_x1)) === 0;
    (scr2_x2 * (1 - scr2_x2)) === 0;
    (scr2_x3 * (1 - scr2_x3)) === 0;
    (scr2_x4 * (1 - scr2_x4)) === 0;
    (scr2_x5 * (1 - scr2_x5)) === 0;
    (scr1_x1_scr2_x1_fused * (1 - scr1_x1_scr2_x1_fused)) === 0;
    component comp_0 = IsEqual();
    comp_0.in[0] <== scr1_x1_scr2_x1_fused;
    comp_0.in[1] <== scr2_x1;
    component comp_1 = NOT();
    comp_1.in <== comp_0.out;
    component comp_2 = NOT();
    comp_2.in <== scr2_x1;
    component comp_3 = NOT();
    comp_3.in <== scr2_x2;
    component comp_4 = OR();
    comp_4.a <== comp_3.out;
    comp_4.b <== scr2_x3;
    component comp_5 = AND();
    comp_5.a <== comp_2.out;
    comp_5.b <== comp_4.out;
    component comp_6 = AND();
    comp_6.a <== comp_5.out;
    comp_6.b <== scr2_x2;
    component comp_7 = OR();
    comp_7.a <== scr2_x1;
    comp_7.b <== scr2_x5;
    component comp_8 = OR();
    comp_8.a <== comp_7.out;
    comp_8.b <== scr2_x4;
    component comp_9 = AND();
    comp_9.a <== comp_6.out;
    comp_9.b <== comp_8.out;
    component comp_10 = OR();
    comp_10.a <== scr2_x5;
    comp_10.b <== scr2_x1;
    component comp_11 = NOT();
    comp_11.in <== scr2_x2;
    component comp_12 = OR();
    comp_12.a <== comp_10.out;
    comp_12.b <== comp_11.out;
    component comp_13 = AND();
    comp_13.a <== comp_9.out;
    comp_13.b <== comp_12.out;
    component comp_14 = NOT();
    comp_14.in <== scr2_x4;
    component comp_15 = AND();
    comp_15.a <== comp_13.out;
    comp_15.b <== comp_14.out;
    component comp_16 = OR();
    comp_16.a <== scr2_x5;
    comp_16.b <== scr2_x4;
    component comp_17 = NOT();
    comp_17.in <== scr2_x3;
    component comp_18 = OR();
    comp_18.a <== comp_16.out;
    comp_18.b <== comp_17.out;
    component comp_19 = AND();
    comp_19.a <== comp_15.out;
    comp_19.b <== comp_18.out;
    component comp_20 = AND();
    comp_20.a <== comp_1.out;
    comp_20.b <== comp_19.out;
    component comp_21 = IsZero();
    comp_21.in <== comp_20.out;
    component comp_22 = NOT();
    comp_22.in <== comp_21.out;
    comp_22.out === 1;
    log("<@> scr1_x1_scr2_x1_fused = ", scr1_x1_scr2_x1_fused);
}

component main = main_template();
